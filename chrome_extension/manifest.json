{
  "manifest_version": 3,
  "name": "MissAV Tab Exporter",
  "version": "4.3.3",
  "description": "播放时自动嗅探 surrit m3u8/UUID 并上报；按详情行采集标题、女优、男优、类型、发行商、导演、标签、简介和封面",
  "permissions": ["tabs", "webRequest", "scripting"],
  "host_permissions": [
    "*://*.missav.ws/*",
    "*://surrit.com/*",
    "*://*.surrit.com/*",
    "https://*/*",
    "http://*/*",
    "http://127.0.0.1:8766/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "MissAV 自动上报（点播放即可，无需导出）"
  }
}
