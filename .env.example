# 复制为 .env 后按本机填写。勿将 .env 提交到 git。
# 程序若检测不到 .env，会自动从此文件生成一份待填的 .env。

# 本机临时下载目录（硬盘）
DOWNLOAD_DIR=

# 本机成片入库目录
JAV_LIBRARY_DIR=

# ---------- NAS 宿主机下载（download_missav_nas.py）----------
# NAS 临时下载目录（硬盘）
NAS_DOWNLOAD_DIR=
# NAS 成片入库目录
NAS_JAV_LIBRARY_DIR=

# 可选：NAS / n8n 连接信息（脚本下载流程可不填）
# NAS_HOST=
# NAS_ACCT=
# NAS_PWD=
# N8N_HOST=
# N8N_ACCT=
# N8N_PWD=
